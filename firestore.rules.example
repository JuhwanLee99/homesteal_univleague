rules_version = '2';

service cloud.firestore {
  function isAdmin() {
    return request.auth != null
      && (request.auth.token.admin == true
        || request.auth.token.email in ['example@ecam.com']); // 여기에 관리자 계정 이메일 추가
  }

  match /databases/{database}/documents {
    // App-wide metadata (currently just the active match pointer)
    match /app/current {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public schedule
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live match state (scoreboard / 문자중계 데이터)
    match /matchStates/{matchId} {
      allow read: if true;
      allow write: if isAdmin();

      // 최근 feed/events 서브컬렉션
      match /feed/{entryId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /events/{entryId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Landing/intro editable content
    match /settings/content {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/homestealContent {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live ticker content (real-time)
    match /settings/liveInfo {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/homestealLiveInfo {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Static content + version metadata
    match /settings/staticContent {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/homestealStaticContent {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/contentMeta {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/homestealContentMeta {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community board
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['title', 'content', 'authorUid', 'authorName', 'createdAt', 'updatedAt']);

      allow update: if request.auth != null
        && (isAdmin() || request.auth.uid == resource.data.authorUid)
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if request.auth != null
        && (isAdmin() || request.auth.uid == resource.data.authorUid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['content', 'authorUid', 'authorName', 'createdAt']);

        allow update: if request.auth != null
          && (isAdmin() || request.auth.uid == resource.data.authorUid)
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if request.auth != null
          && (isAdmin() || request.auth.uid == resource.data.authorUid);
      }
    }

    // Deny anything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
